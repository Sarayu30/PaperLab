# Server-only settings; .env is loaded automatically. Never put keys in Angular configuration.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Project setup still works without a key; AI requests require it.
PAPERLAB_DATABASE_URL=sqlite:///./.data/paperlab.db
# PostgreSQL is configurable but not required for the local walkthrough:
# PAPERLAB_DATABASE_URL=postgresql+psycopg://paperlab:password@localhost:5432/paperlab

